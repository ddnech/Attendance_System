# Copy this file to .env and change what you need:
#   cp .env.example .env
# Docker works fine without a .env file too, these are the same defaults it uses.

# ---- Ports on your machine ----
# These don't clash with the Online Library project, so both can run at once.
# the website (Docker)
CLIENT_PORT=3100
# the Express API
API_PORT=8100
# MySQL
DB_PORT=3308
# inbox for test emails
MAILPIT_PORT=8026

# ---- Time zone ----
# Decides what "today" is, when weekends start and when payroll runs.
APP_TIMEZONE=Asia/Jakarta

# ---- Database ----
DB_NAME=attendance
DB_USER=attendance
DB_PASSWORD=attendance
DB_ROOT_PASSWORD=root
# Only used when you run the API outside Docker (npm run dev). Docker uses "db".
DB_HOST=127.0.0.1

# ---- Login tokens ----
# Any long random string. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-something-long-and-random
JWT_EXPIRES_IN=8h

# ---- Invites ----
# How many days a "set your password" link keeps working.
INVITE_VALID_DAYS=3
# Where the links in invite emails point. Use the address you open the site at.
# APP_URL is for npm run dev, DOCKER_APP_URL is for Docker.
APP_URL=http://localhost:5174
DOCKER_APP_URL=http://localhost:3100

# ---- Demo data ----
# Demo staff, three months of attendance and payslips on first start.
# The admin account is always created.
SEED_DEMO_DATA=true

# ---- Email ----
# By default emails go to Mailpit (http://localhost:8026), nothing is really sent.
# These two are used when you run the API outside Docker:
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# To send real email (Gmail example, needs an App Password), set these and the two Docker ones:
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=465
#   DOCKER_SMTP_HOST=smtp.gmail.com   DOCKER_SMTP_PORT=465
# For Gmail, SMTP_USER is your full Gmail address and SMTP_PASSWORD is the 16 character App Password.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Attendance <no-reply@attendance.local>
